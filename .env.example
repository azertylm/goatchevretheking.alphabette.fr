# Copier ce fichier en `.env` (jamais versionné).

# --- COMMUNAUTÉ (comptes + galerie des pyramides) ---
# Secret de signature des sessions communauté.
# ATTENTION : s'il change (ou s'il est absent et régénéré à chaque démarrage),
# tous les comptes publiés sont déconnectés.
COMMUNITY_SESSION_SECRET=""

# Port du serveur (3000 par défaut)
PORT="3000"
